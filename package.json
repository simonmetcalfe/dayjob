{
  "name": "dayjob",
  "version": "1.2.2",
  "description": "Make great Spotify playlists while you work.",
  "author": "Simon Metcalfe",
  "keywords": [
    "Spotify",
    "playlist",
    "playlists",
    "dj",
    "music",
    "discovery",
    "keyboard",
    "shortcut",
    "shortcuts",
    "automation",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/simonmetcalfe/dayjob.git"
  },
  "license": "MIT",
  "main": "src/main.mjs",
  "overrides": {
    "yauzl": "3.3.1"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "electron-log": "5.4.4",
    "electron-squirrel-startup": "1.0.1",
    "electron-store": "11.0.2",
    "font-awesome": "4.7.0",
    "menubar": "9.5.3",
    "spotify-web-api-node": "5.0.2",
    "v8-compile-cache": "2.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "electron": "43.2.0"
  },
  "scripts": {
    "start": "electron .",
    "build-mac-silicon": "electron-forge package --platform=darwin --arch=arm64",
    "build-mac-intel": "electron-forge package --platform=darwin --arch=x64",
    "build-win": "electron-forge package --platform=win32 --arch=x64",
    "build-all": "npm run build-mac-silicon && npm run build-mac-intel && npm run build-win",
    "package-mac-silicon": "electron-forge make --platform=darwin --arch=arm64 --skip-package",
    "package-mac-intel": "electron-forge make --platform=darwin --arch=x64 --skip-package",
    "prepackage-win": "node scripts/fix-electron-winstaller-7z.js",
    "package-win": "electron-forge make --platform=win32 --arch=x64 --skip-package",
    "package-all": "npm run package-mac-silicon && npm run package-mac-intel && npm run package-win",
    "build-package-all": "npm run build-all && npm run package-all"
  }
}
